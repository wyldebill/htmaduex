// Copy this file to ios/Flutter/Secrets.xcconfig and set your own local key.
// The real Secrets.xcconfig is gitignored to prevent accidental key exposure.
GOOGLE_MAPS_API_KEY_IOS=REPLACE_WITH_YOUR_KEY
FIREBASE_API_KEY=REPLACE_WITH_YOUR_KEY
FIREBASE_APP_ID=REPLACE_WITH_YOUR_APP_ID
FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_YOUR_SENDER_ID
FIREBASE_PROJECT_ID=REPLACE_WITH_YOUR_PROJECT_ID
FIREBASE_AUTH_DOMAIN=REPLACE_WITH_YOUR_AUTH_DOMAIN
FIREBASE_STORAGE_BUCKET=REPLACE_WITH_YOUR_STORAGE_BUCKET
FIREBASE_IOS_BUNDLE_ID=REPLACE_WITH_YOUR_IOS_BUNDLE_ID
